# Copy to .env and fill in what you need. Never commit .env.

# --- Mode ---------------------------------------------------------------
# cached = scripted agent brain (no API keys), live = real LLM, replay = recorded run
AUTOSRE_MODE=cached
AUTOSRE_MAX_ATTEMPTS=3

# --- LLM (live mode) ----------------------------------------------------
# groq | nvidia
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# used when the primary's free daily quota runs out
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# free tier cap; AutoSRE paces itself and trims old context (0 = unlimited)
GROQ_TOKENS_PER_MINUTE=8000
LLM_MAX_OUTPUT_TOKENS=1024
# gpt-oss: keep hidden reasoning short
LLM_REASONING_EFFORT=low

# --- Monitored database (AutoSRE's own least-privilege role) ------------
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=victim_db
TARGET_DB_USER=autosre_agent
TARGET_DB_PASSWORD=autosre_agent_pw
TARGET_APP_NAME_PREFIX=victim-service

# --- Victim app ---------------------------------------------------------
VICTIM_BASE_URL=http://localhost:8001
# VICTIM_LOG_PATH defaults to var/logs/victim.log

# --- Delivery -----------------------------------------------------------
# local (offline bare repo) | github
DELIVERY_PROVIDER=local
# e.g. your-user/victim-service. Also where the Merge button pushes.
GITHUB_REPO=
# Recommended: GitHub App (see docs/GITHUB_APP_SETUP.md)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# Fallback: fine-grained personal access token (only if not using the App)
GITHUB_TOKEN=
# TARGET_REPO_PATH=var/victim_repo_github   # local clone of the GitHub repo (for history)
FRONTEND_URL=http://127.0.0.1:5173

# --- Sandbox ------------------------------------------------------------
# cached (prototype) | auto | docker | subprocess (NOT isolated)
SANDBOX_ENGINE=cached
SANDBOX_TIMEOUT_SECONDS=120

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DEBUG=True
